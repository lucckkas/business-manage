{
  "name": "local-erp-ui",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "generate": "openapi-typescript ../api/openapi.json -o src/api/schema.ts",
    "typecheck": "tsc --noEmit",
    "test:proxy": "node --test proxy.test.mjs",
    "build": "npm run typecheck && vite build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "jsbarcode": "3.12.3",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "openapi-typescript": "7.10.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  }
}
